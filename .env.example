# Django Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=False
ENVIRONMENT=production

# Allowed Hosts (comma-separated)
# For internal use: use IP address or internal hostname
# Examples: 192.168.1.100 or duooidc.internal.local or duooidc
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# Database Configuration - PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=duooidc_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password-here
DB_HOST=localhost
DB_PORT=5432

# Gunicorn WSGI Server Configuration
GUNICORN_WORKERS=4
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_TIMEOUT=30

# Duo OIDC Configuration
# Get these values from your Duo Admin Panel
DUO_CLIENT_ID=your-duo-client-id-here
DUO_CLIENT_SECRET=your-duo-client-secret-here
DUO_API_HOSTNAME=api-xxxxxxxx.duosecurity.com
DUO_REDIRECT_URI=http://192.168.1.100/auth/callback

# Security Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Logging Configuration
LOG_LEVEL=INFO

# Static Files
STATIC_URL=/static/
STATIC_ROOT=/var/www/duooidc/static/
